{
  "rules": {
    ".read": "auth != null",
    "presence": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        "members": {
          "$memberId": {
            ".write": "auth != null && (auth.uid === $memberId || root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'OWNER')"
          }
        },
        "seats": {
          "$seatIndex": {
            ".write": "auth != null"
          }
        },
        "signals": {
          "$signalId": {
            ".write": "auth != null"
          }
        },
        ".write": "auth != null && (data.child('ownerId').val() === auth.uid || !data.exists() || root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'OWNER')"
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "system": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'OWNER')"
    }
  }
}
